# Servidor
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# URBS: preencher apenas depois de obter autorização/documentação oficial
URBS_REALTIME_URL=
URBS_SCHEDULE_URL=
URBS_LINES_URL=
URBS_STOPS_URL=
URBS_API_KEY=

# Google Maps — chave do Google Cloud com faturamento ativo.
# APIs: Maps JavaScript API + Directions API.
# Restrinja a chave aos sites http://localhost:3000/* e https://buzzu.vercel.app/*
# Na Vercel, crie a mesma variável em Settings → Environment Variables.
GOOGLE_MAPS_API_KEY=

# OSRM público (traçado nas ruas). Troque só se tiver um servidor próprio.
OSRM_BASE_URL=https://router.project-osrm.org

# Pagamentos: o servidor nunca deve receber ou armazenar dados de cartão
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
